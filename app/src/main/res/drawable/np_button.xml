<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="90"
    android:exitFadeDuration="90">
    <item android:state_pressed="true" android:drawable="@drawable/sel_on" />
    <item android:state_focused="true" android:drawable="@drawable/sel_on" />
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#14FFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
